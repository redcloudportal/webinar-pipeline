# Lives ONLY on the server, at /root/webinar-pipeline/.env (chmod 600). Never in git, never in chat.
PIPELINE_TOKEN=        # generated on the server; the header x-pipeline-token
RIVERSIDE_API_KEY=     # from Riverside's customer success manager; one key active at a time
SESSION_SECRET=        # generated on the server by deploy.sh; signs the 30-day sign-in cookie
